"""
SLIM — Sparse Linear Methods para recomendacións de playlists
Optimiza a matriz de coeficientes S (items × items) resolvendo un problema de optimización.
"""

import json
import numpy as np
import scipy.sparse as sp
import tensorflow as tf

# PARÁMETROS  
LAMBDA      = 0.01    # peso L1: controla  esparsidade de S
BETA        = 0.01    # peso L2: evita sobreaxuste
LEARNING_RATE = 0.01
EPOCHS      = 200
TOP_K       = 500     # recomendacións por playlist

TRAIN_PATH      = "train_trimmed.json"
TEST_INPUT_PATH = "test_input_trimmed.json"
OUTPUT_JSON     = "recommendations_slim.json"

# 1. CARGA DE DATOS
print("Cargando datos...")

with open(TRAIN_PATH, "r", encoding="utf-8") as f:
    train_data = json.load(f)["playlists"]

with open(TEST_INPUT_PATH, "r", encoding="utf-8") as f:
    test_data = json.load(f)["playlists"]


#    Mapeamos cada track_uri a un índice de columna enteiro.
#    Solo usamos tracks vistos no train — os de test que no estén aquí non poderan
#    puntuarse (son OOV).
print("Construyendo vocabulario de tracks...")

track_to_col = {}   # track_uri → índice columna
for playlist in train_data:
    for track in playlist["tracks"]:
        uri = track["track_uri"]
        if uri not in track_to_col:
            track_to_col[uri] = len(track_to_col)

col_to_track = {v: k for k, v in track_to_col.items()}  # inverso: columna → uri

n_playlists = len(train_data)
n_tracks    = len(track_to_col)
print(f"  Playlists train : {n_playlists}")
print(f"  Tracks únicos   : {n_tracks}")


# 3. CONSTRUCCIÓN DE LA MATRIZ (sparse)
#    X[i, j] = 1  si a playlist i contén o track j
#    logo convertese a CSR pra operacións eficientes.

print("Construyendo matriz (playlists × tracks)...")

rows, cols = [], []
for row_idx, playlist in enumerate(train_data):
    for track in playlist["tracks"]:
        col_idx = track_to_col[track["track_uri"]]
        rows.append(row_idx)
        cols.append(col_idx)

data = np.ones(len(rows), dtype=np.float32)
X_sparse = sp.csr_matrix((data, (rows, cols)), shape=(n_playlists, n_tracks))

print(f"  Forma de X      : {X_sparse.shape}")
print(f"  Densidad        : {X_sparse.nnz / (n_playlists * n_tracks):.6f}")

# 4. CONVERSIÓN A tf.SparseTensor
#    TensorFlow traballa con SparseTensors pra matrices dispersas.
#    Necesitamos os índices en formato (fila, columna) e os valores.
print("Convirtiendo a tf.SparseTensor...")

X_coo = X_sparse.tocoo()  # COO: arrays separados de filas, cols, vals

# os índices deben ser int64 e estar en formato [[fila, col], ...]
X_indices = np.column_stack([X_coo.row, X_coo.col]).astype(np.int64)
X_values  = X_coo.data.astype(np.float32)
X_shape   = [n_playlists, n_tracks]

X_tf = tf.SparseTensor(
    indices=X_indices,
    values=X_values,
    dense_shape=X_shape
)
# tf.SparseTensor require que os índices estén ordeados lexicográficamente
X_tf = tf.sparse.reorder(X_tf)

# Tamén necesitamos X como tensor denso pra algunhas operacións do loss.
# Pra o trimmed (4347×1704) ocupa ~28MB en float32 → aceptable.
X_dense = tf.sparse.to_dense(X_tf)  # shape: (n_playlists, n_tracks)

# S é a matriz de coeficientes item-to-item que queremos aprender.
# inicializamos con valores pequenos aleatorios.
# restrinximos a S ≥ 0 aplicando tf.nn.relu tras cada actualización.
# a diagonal forzase a 0 cunha máscara.
print("Inicializando S...")

S = tf.Variable(
    tf.random.uniform([n_tracks, n_tracks], minval=0.0, maxval=0.01),
    trainable=True,
    name="S",
    dtype=tf.float32
)

# Máscara pra forzar diag(S) = 0: 1 en todos excepto na diagonal
diag_mask = tf.ones([n_tracks, n_tracks]) - tf.eye(n_tracks)

def apply_constraints(S_var):
    """Aplica S ≥ 0 e diag(S) = 0 en cada paso.

    Esto é proxectar ao espazo factible despois de cada gradiente,
    equivalente ao projected gradient descent.
    """
    return tf.nn.relu(S_var) * diag_mask

# Queremos que X·S ≈ X, é dicir, que cada playlist
# podase reconstruir coma combinación lineal de outras.
#
#  L1 (lasso) — penaliza o número de coeficientes != 0,
#  forzando que S sea sparse. Canto maior λ, más sparse.
#
#  L2 (ridge) — penaliza coeficientes grandes,
#  previndo sobreaxuste.
# ─────────────────────────────────────────────
@tf.function  # Compila o grafo para maior velocidade
def compute_loss(S_constrained):
    # X·S: reconstrucción de X usando S  →  shape (n_playlists, n_tracks)
    XS = tf.matmul(X_dense, S_constrained)

    # Erro de reconstrucción: ||X - X·S||2_F
    # tf.norm con ord='fro' é a norma de Frobenius: sqrt(sum de cuadrados)
    # Elevamos ao cadrado para obter a suma de cadrados
    reconstruction_loss = tf.reduce_sum(tf.square(X_dense - XS))

    # Regularización L1
    l1_reg = LAMBDA * tf.reduce_sum(tf.abs(S_constrained))

    # Regularización L2
    l2_reg = BETA * tf.reduce_sum(tf.square(S_constrained))

    return reconstruction_loss + l1_reg + l2_reg

# Usamos SGD como indica el enunciado.
# Calculamos gradientes con GradientTape (autodiff de TF)
# Aplicamos o gradiente sobre S
# Proxectamos S ao espacio factible (relu + máscara diagonal)
optimizer = tf.keras.optimizers.SGD(learning_rate=LEARNING_RATE)

print(f"\nEntrenando SLIM ({EPOCHS} epochs)...")
print(f"  λ (L1) = {LAMBDA}  |  β (L2) = {BETA}  |  lr = {LEARNING_RATE}")
print("-" * 50)

for epoch in range(EPOCHS):
    with tf.GradientTape() as tape:
        # Aplica restriccións antes de calcular a loss
        S_constrained = apply_constraints(S)
        loss = compute_loss(S_constrained)

    # tf.GradientTape rexistra todas as operacións dentro do bloque 'with'
    # e calcula automáticamente dL/dS (diferenciación automática)
    gradients = tape.gradient(loss, [S])

    # optimizador aplica a actualización: S ← S - lr · dL/dS
    optimizer.apply_gradients(zip(gradients, [S]))

    # Proyectar S al espacio factible (relu + diagonal = 0)
    S.assign(apply_constraints(S))

    if (epoch + 1) % 20 == 0:
        print(f"  Epoch {epoch+1:>4}/{EPOCHS}  |  Loss: {loss.numpy():.6f}")

# S final con restricciones aplicadas
S_final = apply_constraints(S).numpy()  # shape: (n_tracks, n_tracks)
print(f"\nEntrenamiento completado.")
print(f"  S: {S_final.shape} | no-zeros: {np.count_nonzero(S_final)} | max: {S_final.max():.4f}")

# POPULARIDADE COMO FALLBACK

track_popularity = np.array(X_sparse.sum(axis=0)).flatten()  # apariciones por track
popular_tracks = np.argsort(-track_popularity).tolist()       # orden descendente


#  Pra cada playlist de test:
#  Construir vector interacciones x_i (1×n_tracks) usando sÓ os seed tracks que estén 
#  no vocabulario.
#  Calcular scores = x_i · S  →  puntuación track
#  Excluir tracks xa presentes na playlist (no los repetimos)
#  Ordea por score descendente e tomar o top-500
#  Se menos de 500, encher con popularidade

print("\nGenerando recomendaciones para playlists de test...")

recommendations = []

for playlist in test_data:
    pid = playlist["pid"]

    # Tracks seed desta playlist que están no noso vocabulario
    known_cols = []
    for track in playlist["tracks"]:
        uri = track["track_uri"]
        if uri in track_to_col:
            known_cols.append(track_to_col[uri])

    if len(known_cols) == 0:
        # Sin seeds: fallback total por popularidade
        recs_cols = [c for c in popular_tracks if c not in set(known_cols)][:TOP_K]
    else:
        # Vector de interaccións de esta playlist: shape (n_tracks,)
        x_i = np.zeros(n_tracks, dtype=np.float32)
        for col in known_cols:
            x_i[col] = 1.0

        # Score para cada track: x_i · S
        # S[j] é a j-ésima columna → canto contribue no track j
        # a cada track candidato
        scores = x_i @ S_final  # shape: (n_tracks,)

        # Excluir tracks xa coñecidos (ponemos su score a -inf)
        known_set = set(known_cols)
        scores[list(known_set)] = -np.inf

        # Top-K por score descendente
        top_indices = np.argsort(-scores)[:TOP_K]

        # encher con popularidade
        recs_cols = [int(i) for i in top_indices if scores[i] > -np.inf]

        if len(recs_cols) < TOP_K:
            fallback = [c for c in popular_tracks
                        if c not in known_set and c not in set(recs_cols)]
            recs_cols += fallback[:TOP_K - len(recs_cols)]

    recs_uris = [col_to_track[c] for c in recs_cols[:TOP_K]]

    recommendations.append({
        "pid": pid,
        "recommendations": recs_uris
    })

with open(OUTPUT_JSON, "w", encoding="utf-8") as f:
    json.dump(recommendations, f, ensure_ascii=False, indent=2)

print(f"\nGuardado: {OUTPUT_JSON}")
print(f"  Playlists de test procesadas: {len(recommendations)}")
print(f"  Recomendaciones por playlist : {len(recommendations[0]['recommendations'])}")
print(f"\nEjemplo (pid={recommendations[0]['pid']}):")
print(f"  Primeras 3 recomendaciones: {recommendations[0]['recommendations'][:3]}")
