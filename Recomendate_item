import json
from collections import defaultdict
from scipy.sparse import load_npz

NEIGHBORHOOD_PATH   = "neighborhood_item.json"
TEST_MATRIX_PATH    = "test_matrix.npz"
TRACK_TO_COL_PATH   = "track_to_col.json"
TOP500_PATH         = "top_500_tracks.json"
OUTPUT_PATH         = "recommendations_item.json"

N_RECOMMENDATIONS = 500   #número de tracks a recomendar por playlist

#Cargar el vecindario 
print("Cargando vecindario...")
with open(NEIGHBORHOOD_PATH, "r", encoding="utf-8") as f:
    item_neighbors = json.load(f)
print(f"  Vecindarios cargados: {len(item_neighbors)}")


#Cargar mappings uri colmna 
with open(TRACK_TO_COL_PATH, "r", encoding="utf-8") as f:
    track_to_col = json.load(f)


#Convertimos los indices de matriz en uris 
col_to_track      = {v: k for k, v in track_to_col.items()}
col_to_track_test = col_to_track   #mismo espacio de columnas

print(f"  Tracks training: {len(track_to_col)}")
print(f"  Tracks test:     {len(col_to_track_test)}")


#Cargar las tracks populares y lo usamos cuando falten recomendaciones 
print("Cargando tracks populares (fallback)...")
with open(TOP500_PATH, "r", encoding="utf-8") as f:
    top500_raw = json.load(f)

#Lista ordenada de URIs populares
popular_uris_ordered = [entry["track_uri"] for entry in top500_raw]
print(f"  Tracks en pool de popularidad: {len(popular_uris_ordered)}")


#carga de la matriz de test 
print("Cargando test matrix...")
test_matrix = load_npz(TEST_MATRIX_PATH).tocsr()
n_playlists = test_matrix.shape[0]
print(f"  Shape: {test_matrix.shape}")


#Recomendaciones 
print(f"\nGenerando recomendaciones ({n_playlists} playlists)...\n")

K_VALUES = [15, 30, 60, 100, 150] #Probamos y comprobamos distitnos valores de k 

for k in K_VALUES:
    print(f"\n=== K = {k} ===")
    recommendations = []
    #Contadores de diagnóstico
    total_seed_tracks       = 0
    tracks_in_neighborhood  = 0
    playlists_with_fallback = 0

    for pid in range(n_playlists):

        if pid % 1000 == 0:
            print(f"  Playlist {pid}/{n_playlists}...")

        try:
            row = test_matrix.getrow(pid)

            #Canciones que ya están en la playlist 
            present_uris = set()
            for test_col_id in row.indices:
                total_seed_tracks += 1
                uri = col_to_track_test.get(test_col_id)
                if uri is not None:
                    present_uris.add(uri)

        #Para cada canción seed que tiene vecindario, sumamos las
        #similitudes de sus vecinos
            scores = defaultdict(float)

            for uri in present_uris:
                neighbors = item_neighbors.get(uri) #Buscar los vecinos para cada canción en la playlist
                if neighbors is None:
                    continue
                tracks_in_neighborhood += 1
                for neighbor_uri, similarity in neighbors[:k]: #Si no está ya en la playlist sumamos la similitud 
                    if neighbor_uri not in present_uris:
                        scores[neighbor_uri] += similarity

        #Ordenar por score descendente y tomar top N
            ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)
            rec_uris = [uri for uri, _ in ranked[:N_RECOMMENDATIONS]]

        #Si el item-based no llega a 500 rellenamos en orden de
        #popularidad saltando tracks ya en seed o ya recomendados.
            if len(rec_uris) < N_RECOMMENDATIONS:
                playlists_with_fallback += 1
                rec_set = set(rec_uris)
                for pop_uri in popular_uris_ordered:
                    if len(rec_uris) >= N_RECOMMENDATIONS:
                        break
                    if pop_uri not in present_uris and pop_uri not in rec_set:
                        rec_uris.append(pop_uri)
                        rec_set.add(pop_uri)

        except Exception as e:
            print(f"  Error en playlist {pid}: {e}")
            #top populares que no están en seed
            rec_uris = []
            present_uris = set()
            rec_set = set()
            for pop_uri in popular_uris_ordered:
                if len(rec_uris) >= N_RECOMMENDATIONS:
                    break
                if pop_uri not in present_uris and pop_uri not in rec_set:
                    rec_uris.append(pop_uri)
                    rec_set.add(pop_uri)

        recommendations.append({
            "pid": pid,
            "recommendations": rec_uris
        })

    print("\n--- DIAGNÓSTICO ---")
    print(f"Total playlists procesadas:              {n_playlists}")
    print(f"Total tracks en seeds:                   {total_seed_tracks}")
    print(f"Tracks seed con vecindario disponible:   {tracks_in_neighborhood}")
    print(f"Playlists con fallback de popularidad:   {playlists_with_fallback}")
    print(f"Playlists con fallback / total:          "
    f"{playlists_with_fallback}/{n_playlists} "
    f"({100*playlists_with_fallback/n_playlists:.1f}%)")
    # Verificar que todas las playlists tienen exactamente 500 recomendaciones
    lengths = [len(r["recommendations"]) for r in recommendations]
    print(f"Longitud mín/máx de listas:              {min(lengths)} / {max(lengths)}")
    assert min(lengths) == N_RECOMMENDATIONS, "Alguna playlist tiene menos de 500 recomendaciones"
    print("OK: todas las playlists tienen exactamente 500 recomendaciones.")


    output_path = f"recommendations_item_k{k}.json"
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(recommendations, f)
    print(f"Guardado: {output_path}")

