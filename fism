"""
FISM — Factored Item Similarity Model para recomendación de playlists
FISM extende SLIM descompoñendo a matriz S en dúas matrices de menos rango:

    S = P · Qᵀ   donde P, Q ∈ ℝ^(items × k)

Reduce o número de parámetros de items² a 2·items·k, o que permite escalar a datasets
grandes e evitar sobreaxuste.

usamos a mesma función de reconstrucción que SLIM, pero parametrizando S como PQ traspuesta.
"""

import json
import numpy as np
import scipy.sparse as sp
import tensorflow as tf

# PARÁMETROS

K             = 5      # dimensión do espazo latente (rango da factorización)
LAMBDA        = 0.01    # peso L1
BETA          = 0.01    # peso L2
LEARNING_RATE = 0.005   # lr conservador: multiplicación P·Qᵀ amplifica gradientes
EPOCHS        = 500
GRAD_CLIP     = 5.0     # gradient clipping: evita explosion de NaN na optimización bilineal
TOP_K         = 500

#Rutas
TRAIN_PATH      = "train_trimmed.json"
TEST_INPUT_PATH = "test_input_trimmed.json"
OUTPUT_JSON     = "recommendations_fism.json"

print("Cargando datos...")

with open(TRAIN_PATH, "r", encoding="utf-8") as f:
    train_data = json.load(f)["playlists"]

with open(TEST_INPUT_PATH, "r", encoding="utf-8") as f:
    test_data = json.load(f)["playlists"]

print("Construyendo vocabulario de tracks...")

track_to_col = {}
for playlist in train_data:
    for track in playlist["tracks"]:
        uri = track["track_uri"]
        if uri not in track_to_col:
            track_to_col[uri] = len(track_to_col)

col_to_track = {v: k for k, v in track_to_col.items()}

n_playlists = len(train_data)
n_tracks    = len(track_to_col)
print(f"  Playlists train : {n_playlists}")
print(f"  Tracks únicos   : {n_tracks}")
print(f"  Dimensión latente k = {K}")

print("Construyendo matriz (playlists × tracks)...")

rows, cols = [], []
for row_idx, playlist in enumerate(train_data):
    for track in playlist["tracks"]:
        col_idx = track_to_col[track["track_uri"]]
        rows.append(row_idx)
        cols.append(col_idx)

data = np.ones(len(rows), dtype=np.float32)
X_sparse = sp.csr_matrix((data, (rows, cols)), shape=(n_playlists, n_tracks))

print(f"  Forma de X      : {X_sparse.shape}")
print(f"  Densidad        : {X_sparse.nnz / (n_playlists * n_tracks):.6f}")

print("Convirtiendo a tf.SparseTensor...")

X_coo     = X_sparse.tocoo()
X_indices = np.column_stack([X_coo.row, X_coo.col]).astype(np.int64)
X_values  = X_coo.data.astype(np.float32)
X_shape   = [n_playlists, n_tracks]

X_tf = tf.SparseTensor(indices=X_indices, values=X_values, dense_shape=X_shape)
X_tf = tf.sparse.reorder(X_tf)

X_dense = tf.sparse.to_dense(X_tf)  # (n_playlists, n_tracks)

#INICIALIZACIÓN DE P Y Q
#    FISM  factoriza: S ≈ P · Qᵀ
#      P: matriz de "emisión"  — cómo cada item proxecta ao espazo latente
#      Q: matriz de "recepción" — cómo cada item recibe do espazo latente
#
#    Inicialización con escala pequeña.
print("Inicializando P y Q...")

init_scale = 0.01 / np.sqrt(K)  # escala inversamente proporcional a k

P = tf.Variable(
    tf.random.normal([n_tracks, K], stddev=init_scale),
    trainable=True,
    name="P",
    dtype=tf.float32
)

Q = tf.Variable(
    tf.random.normal([n_tracks, K], stddev=init_scale),
    trainable=True,
    name="Q",
    dtype=tf.float32
)

# Máscara para forzar diag(S) = 0
# diag_mask[i,j] = 0 si i==j, 1 en otro caso
diag_mask = tf.ones([n_tracks, n_tracks]) - tf.eye(n_tracks)

def compute_S(P_var, Q_var):
    """Reconstruye S = P·Qᵀ con diag(S) = 0.
    - Cada fila de P é o vector latente 'emisor' dun item
    - Cada fila de Q é o vector latente 'receptor' dun item
    - S[i,j] = P[i] · Q[j]  →  similitud item i e item j

    FISM solo aprende 2 × n_tracks × k parámetros:
    FISM:  2 × 1704 × 20 = 68.160 parámetros  (con k=20)
    """
    S = tf.matmul(P_var, Q_var, transpose_b=True)  # (n_tracks, n_tracks)
    return S * diag_mask  # diag(S) = 0

#    FUNCIÓN DE PÉRDIDA
#    Igual ca SLIM pero sobre S = P·Qᵀ

@tf.function
def compute_loss(P_var, Q_var):
    S = compute_S(P_var, Q_var)

    # Reconstrucción: X·S  →  (n_playlists, n_tracks)
    XS = tf.matmul(X_dense, S)

    # Erro de reconstrucción: ||X - X·S||²_F
    reconstruction_loss = tf.reduce_sum(tf.square(X_dense - XS))

    # L1: λ · ||S||_1  — suma de valores absolutos de todos os elementos
    l1_reg = LAMBDA * tf.reduce_sum(tf.abs(S))

    # L2: β · ||S||²_F  — suma de cadrados de todos os elementos
    l2_reg = BETA * tf.reduce_sum(tf.square(S))

    return reconstruction_loss + l1_reg + l2_reg

# BUCLE DE ENTRENAMIENTO
# GradientTape calcula dL/dP y dL/dQ simultáneamente.
# O optimizador actualiza P y Q en paralelo.
# nesta implementación non se impón non negatividade explícita   

optimizer = tf.keras.optimizers.SGD(learning_rate=LEARNING_RATE)

print(f"\nEntrenando FISM ({EPOCHS} epochs)...")
print(f"  k = {K}  |  λ (L1) = {LAMBDA}  |  β (L2) = {BETA}  |  lr = {LEARNING_RATE}  |  clip = {GRAD_CLIP}")
print("-" * 50)

for epoch in range(EPOCHS):
    with tf.GradientTape() as tape:
        # tape rexistra as operaciones sobre P e Q (ambas son tf.Variable)
        loss = compute_loss(P, Q)

    # Gradientes respecto a P e Q
    gradients = tape.gradient(loss, [P, Q])

    # Gradient clipping: limita a norma de cada gradiente a GRAD_CLIP.
    # En optimización bilineal (P·Qᵀ), os gradientes se amplifican
    # mutuamente e poden explotar (→ NaN). O clipping estabilizaos.
    gradients, _ = tf.clip_by_global_norm(gradients, GRAD_CLIP)

    # Actualización: P ← P - lr·dL/dP,  Q ← Q - lr·dL/dQ
    optimizer.apply_gradients(zip(gradients, [P, Q]))

    if (epoch + 1) % 20 == 0:
        print(f"  Epoch {epoch+1:>4}/{EPOCHS}  |  Loss: {loss.numpy():.6f}")

# Reconstruir S final dende P e Q entrenados
S_final = compute_S(P, Q).numpy()  # shape: (n_tracks, n_tracks)
print(f"\nEntrenamiento completado.")
print(f"  S = P·Qᵀ: {S_final.shape} | max: {S_final.max():.4f} | min: {S_final.min():.4f}")

# POPULARIDAD COMO FALLBACK
track_popularity = np.array(X_sparse.sum(axis=0)).flatten()
popular_tracks   = np.argsort(-track_popularity).tolist()


print("\nGenerando recomendaciones para playlists de test...")
#    Idéntico a SLIM: scores = x_i · S
#    La diferencia es que S viene de P·Qᵀ 
recommendations = []

for playlist in test_data:
    pid = playlist["pid"]

    known_cols = []
    for track in playlist["tracks"]:
        uri = track["track_uri"]
        if uri in track_to_col:
            known_cols.append(track_to_col[uri])

    if len(known_cols) == 0:
        # Fallback total por popularidad
        recs_cols = [c for c in popular_tracks if c not in set(known_cols)][:TOP_K]
    else:
        x_i = np.zeros(n_tracks, dtype=np.float32)
        for col in known_cols:
            x_i[col] = 1.0

        # scores = x_i · S = x_i · P·Qᵀ
        # Podemos calcular eficientemente como (x_i·P)·Qᵀ
        # evitando materializar S completa (útil para datasets grandes)
        #   latent = x_i @ P  →  shape (k,)
        #   scores = latent @ Q.T  →  shape (n_tracks,)
        latent = x_i @ P.numpy()          # (k,)
        scores = latent @ Q.numpy().T     # (n_tracks,)

        known_set = set(known_cols)
        scores[list(known_set)] = -np.inf

        top_indices = np.argsort(-scores)[:TOP_K]
        recs_cols   = [int(i) for i in top_indices if scores[i] > -np.inf]

        if len(recs_cols) < TOP_K:
            fallback  = [c for c in popular_tracks
                         if c not in known_set and c not in set(recs_cols)]
            recs_cols += fallback[:TOP_K - len(recs_cols)]

    recs_uris = [col_to_track[c] for c in recs_cols[:TOP_K]]

    recommendations.append({
        "pid": pid,
        "recommendations": recs_uris
    })

with open(OUTPUT_JSON, "w", encoding="utf-8") as f:
    json.dump(recommendations, f, ensure_ascii=False, indent=2)

print(f"\nGuardado: {OUTPUT_JSON}")
print(f"  Playlists de test procesadas: {len(recommendations)}")
print(f"  Recomendaciones por playlist : {len(recommendations[0]['recommendations'])}")
print(f"\nEjemplo (pid={recommendations[0]['pid']}):")
print(f"  Primeras 3 recomendaciones: {recommendations[0]['recommendations'][:3]}")
